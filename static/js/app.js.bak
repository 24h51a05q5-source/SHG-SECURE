                    <!-- Financial Awareness card list -->
                    <div id="financial-awareness-card" class="glass-panel p-6 rounded-2xl border border-slate-200">
                        <!-- Loaded dynamically via translation switcher -->
                    </div>
                    
                    <!-- Concerns/Disputes Module -->
                    ${renderGeneralReportFormHTML()}
                </div>
            </div>
        </div>
    `;
    
    // Fill awareness content
    renderFinancialAwareness();
    
    // Draw SVG charts
    drawRiskChart();
    drawReconciliationChart();
}

function renderScenarioNotificationBanner() {
    const sc = appState.scenario;
    const scenarios = {
        'A': {
            title: "Scenario A: Normal Operations",
            desc: "All 10 members paid contributions digitally on time. Reconciliation matches perfectly, and risk is LOW. Group loan is safely serviced.",
            color: "border-emerald-200 bg-emerald-50 text-emerald-950"
        },
        'B': {
            title: "Scenario B: Shortfall Detected (8 of 10 Paid)",
            desc: "8 members paid on time, but 2 (Geetha and Shanti) are pending. Group faces ₹2,000 bank loan payment shortfall risk. Risk level rises to MEDIUM.",
            color: "border-amber-200 bg-amber-50 text-amber-950 animate-pulse-warning"
        },
        'C': {
            title: "Scenario C: Cash Collection Mismatch Alert",
            desc: "Leader collected ₹2,000 cash from 2 members. Total ledger records ₹10,000, but actual bank account received only ₹8,000. System raises a reconciliation alert.",
            color: "border-red-200 bg-red-50 text-red-950 animate-pulse-danger"
        },
        'D': {
            title: "Scenario D: Major Transaction Unaware Alert",
            desc: "A new bank loan of ₹3,00,000 was sanctioned. 3 members marked themselves as UNAWARE. Dispute raised. Loan flagged for review.",
            color: "border-purple-200 bg-purple-50 text-purple-950"
        },
        'E': {
            title: "Scenario E: Unusual Transaction Anomaly Alert",
            desc: "Leader entered an expense of ₹1,50,000. Risk Engine flagged it as anomalous size compared to previous logs (avg. ₹13,750). marked PENDING review.",
            color: "border-amber-200 bg-amber-50 text-amber-950"
        },
        'F': {
            title: "Scenario F: Deadline Critical Alarm",
            desc: "Repayment deadline is TOMORROW. ₹2,000 shortfall remains. Risk spikes to HIGH, triggering automated mobile and ledger warning signals.",
            color: "border-red-200 bg-red-50 text-red-950 animate-pulse-danger"
        }
    };
    
    const banner = scenarios[sc] || scenarios['A'];
    
    return `
        <div class="border-l-4 p-4 rounded-r-xl border-slate-300 shadow-sm flex flex-col md:flex-row justify-between items-start md:items-center gap-4 mb-8 ${banner.color}">
            <div>
                <h4 class="font-extrabold text-sm sm:text-base">${banner.title}</h4>
                <p class="text-xs mt-1 text-slate-600 max-w-3xl">${banner.desc}</p>
            </div>
            <button onclick="resetSystem();" class="text-xs bg-slate-900 text-white font-bold px-3 py-2 rounded-lg hover:bg-slate-800 transition shrink-0">
                ↺ Reset Demo
            </button>
        </div>
    `;
}

function renderRoleSpecificDashboard() {
    const role = appState.currentUser.role;
    if (role === 'MEMBER') {
        return renderMemberDashboardHTML();
    } else if (role === 'LEADER') {
        return renderLeaderDashboardHTML();
    } else if (role === 'REVIEWER') {
        return renderReviewerDashboardHTML();
    } else if (role === 'ADMIN') {
        return renderAdminDashboardHTML();
    }
    return '';
}

// --- MEMBER WORKFLOW VIEW ---
function renderMemberDashboardHTML() {
    const myUser = appState.currentUser;
    const myPayment = appState.members.find(m => m.id === myUser.id);
    const paymentStatus = myPayment && myPayment.status === 'VERIFIED';
    
    // Check if there are active loans requiring member verifications/votes
    let verificationsHTML = '';
    
    // Check loans
    appState.loans.forEach(loan => {
        const myVote = loan.verifications.find(v => v.username === myUser.username);
        if (loan.status === 'UNDER_REVIEW' || loan.status === 'PENDING_VERIFICATION') {
            const hasVoted = myVote && myVote.response !== 'PENDING';
            verificationsHTML += `
                <div class="bg-gradient-to-r from-emerald-50 to-blue-50/50 p-6 rounded-xl border border-emerald-100 flex flex-col gap-4">
                    <div class="flex flex-wrap justify-between items-start">
                        <div>
                            <span class="bg-amber-100 text-amber-900 text-[10px] font-extrabold tracking-wider px-2 py-0.5 rounded-full uppercase">Loan Verification Needed</span>
                            <h4 class="font-extrabold text-base text-slate-800 mt-2">New Bank Loan Sanctioned: ₹${loan.amount.toLocaleString('en-IN')}</h4>
                            <p class="text-xs text-slate-500 mt-1">Bank: ${loan.bank_name} | Purpose: ${loan.purpose}</p>
                        </div>
                        <div class="text-right">
                            <span class="text-xs font-semibold text-slate-500">AWARENESS VOTE</span>
                            <div class="text-xs font-bold text-slate-800 mt-1">${loan.aware_count}/10 Members Aware</div>
                        </div>
                    </div>
                    
                    ${hasVoted ? `
                        <div class="bg-white/80 border border-slate-200 px-4 py-2.5 rounded-lg text-xs font-semibold text-slate-700 flex justify-between items-center">
                            <span>Your response: <strong class="${myVote.response === 'AWARE' ? 'text-emerald-700' : 'text-red-700'}">${myVote.response}</strong></span>
                            <span class="text-[10px] text-slate-400">Recorded: ${loan.sanctioned_date}</span>
                        </div>
                    ` : `
                        <div>
                            <p class="text-xs text-slate-600 font-semibold mb-3">Were you aware of this loan application and group discussion?</p>
                            <div class="flex flex-wrap gap-2">
                                <button onclick="submitVote('LOAN', ${loan.id}, 'AWARE');" class="bg-emerald-800 hover:bg-emerald-950 text-white font-bold text-xs px-4 py-2 rounded-lg transition">
                                    ✓ Yes, I am Aware
                                </button>
                                <button onclick="submitVote('LOAN', ${loan.id}, 'UNAWARE');" class="bg-amber-500 hover:bg-amber-600 text-white font-bold text-xs px-4 py-2 rounded-lg transition">
                                    ✗ No, I am Not Aware
                                </button>
                                <button onclick="openDisputeModal('LOAN', ${loan.id});" class="bg-red-600 hover:bg-red-700 text-white font-bold text-xs px-4 py-2 rounded-lg transition">
                                    ⚠️ Dispute Loan
                                </button>
                            </div>
                        </div>
                    `}
                </div>
            `;
        }
    });

    // Check expenses
    appState.expenses.forEach(exp => {
        const myVote = exp.verifications.find(v => v.username === myUser.username);
        if (exp.status === 'PENDING') {
            const hasVoted = myVote && myVote.response !== 'PENDING';
            verificationsHTML += `
                <div class="bg-gradient-to-r from-amber-50 to-red-50/50 p-6 rounded-xl border border-amber-100 flex flex-col gap-4 mt-4">
                    <div class="flex flex-wrap justify-between items-start">
                        <div>
                            <span class="bg-amber-100 text-amber-900 text-[10px] font-extrabold tracking-wider px-2 py-0.5 rounded-full uppercase">Expense Verification Needed</span>
                            <h4 class="font-extrabold text-base text-slate-800 mt-2">New Expense Drafted: ₹${exp.amount.toLocaleString('en-IN')}</h4>
                            <p class="text-xs text-slate-500 mt-1">Initiated by: ${exp.initiator_name} | Purpose: ${exp.purpose}</p>
                        </div>
                        <div class="text-right">
                            <span class="text-xs font-semibold text-slate-500">AWARENESS VOTE</span>
                            <div class="text-xs font-bold text-slate-800 mt-1">${exp.aware_count}/10 Members Aware</div>
                        </div>
                    </div>
                    
                    ${hasVoted ? `
                        <div class="bg-white/80 border border-slate-200 px-4 py-2.5 rounded-lg text-xs font-semibold text-slate-700 flex justify-between items-center">
                            <span>Your response: <strong class="${myVote.response === 'AWARE' ? 'text-emerald-700' : 'text-red-700'}">${myVote.response}</strong></span>
                            <span class="text-[10px] text-slate-400">Recorded: ${exp.date}</span>
                        </div>
                    ` : `
                        <div>
                            <p class="text-xs text-slate-600 font-semibold mb-3">Were you informed and did you approve this expense?</p>
                            <div class="flex flex-wrap gap-2">
                                <button onclick="submitVote('EXPENSE', ${exp.id}, 'AWARE');" class="bg-emerald-800 hover:bg-emerald-950 text-white font-bold text-xs px-4 py-2 rounded-lg transition">
                                    ✓ Yes, Approve
                                </button>
                                <button onclick="submitVote('EXPENSE', ${exp.id}, 'UNAWARE');" class="bg-amber-500 hover:bg-amber-600 text-white font-bold text-xs px-4 py-2 rounded-lg transition">
                                    ✗ No, Reject / Disapprove
                                </button>
                                <button onclick="openDisputeModal('EXPENSE', ${exp.id});" class="bg-red-600 hover:bg-red-700 text-white font-bold text-xs px-4 py-2 rounded-lg transition">
                                    ⚠️ File Concern
                                </button>
                            </div>
                        </div>
                    `}
                </div>
            `;
        }
    });

    let historyHTML = '';
    if (paymentStatus) {
        historyHTML = `
            <div onclick="showReceipt({
                shgName: 'Mahila Jyothi SHG',
                memberName: '${myUser.full_name}',
                amount: 1000.00,
                purpose: 'Monthly Contribution Dues',
                date: '${myPayment.payment_date || "08 Aug 2026"}',
                txnId: '${myPayment.txn_id || "SHG-DEMO-0001"}',
                status: 'VERIFIED',
                message: 'Payment successfully recorded in SHG financial ledger.'
            });" class="p-3 border border-slate-100 hover:border-emerald-700 bg-emerald-50/20 rounded-lg cursor-pointer transition flex justify-between items-center">
                <div>
                    <span class="text-xs font-bold text-slate-800 block">August 2026</span>
                    <span class="text-[9px] text-slate-400 font-mono">${myPayment.txn_id || 'SHG-DEMO-0001'} &bull; ${appState.lastPaymentMethod || 'UPI Demo'}</span>
                </div>
                <div class="text-right">
                    <span class="text-xs font-extrabold text-emerald-800 block">₹1,000</span>
                    <span class="text-[9px] bg-emerald-100 text-emerald-800 px-1 py-0.5 rounded font-bold uppercase">✓ VERIFIED</span>
                </div>
            </div>
        `;
    } else {
        historyHTML = `
            <div class="text-center py-6 text-xs text-slate-400 font-semibold">
                No payment records found for August 2026.
            </div>
        `;
    }

    historyHTML += `
        <div onclick="showReceipt({
            shgName: 'Mahila Jyothi SHG',
            memberName: '${myUser.full_name}',
            amount: 1000.00,
            purpose: 'Monthly Contribution',
            date: '07 Jul 2026',
            txnId: 'SHG-DEMO-771239',
            status: 'VERIFIED',
            message: 'Payment successfully recorded in SHG financial ledger.'
        });" class="p-3 border border-slate-100 hover:border-emerald-700 bg-slate-50/50 rounded-lg cursor-pointer transition flex justify-between items-center mt-2">
            <div>
                <span class="text-xs font-bold text-slate-800 block">July 2026</span>
                <span class="text-[9px] text-slate-400 font-mono">SHG-DEMO-771239 &bull; UPI Demo</span>
            </div>
            <div class="text-right">
                <span class="text-xs font-extrabold text-emerald-850 block">₹1,000</span>
                <span class="text-[9px] bg-emerald-100 text-emerald-850 px-1 py-0.5 rounded font-bold uppercase">✓ VERIFIED</span>
            </div>
        </div>
    `;

    return `
        <div class="glass-panel p-8 rounded-2xl border border-slate-200 space-y-6">
            <div class="flex flex-wrap justify-between items-center gap-4 border-b border-slate-100 pb-5">
                <div>
                    <h2 class="font-extrabold text-2xl text-emerald-950">Mahila Jyothi SHG</h2>
                    <p class="text-xs text-slate-500 mt-1">SHG Group ID: SHG001 | Registered Bank Account: State Bank of India *9842</p>
                </div>
                <div class="text-right">
                    <span class="text-xs font-semibold text-slate-400 uppercase">My ID Code</span>
                    <p class="font-extrabold text-lg text-emerald-800">${myUser.username === 'reviewer' ? 'RO-001' : myUser.username === 'admin' ? 'ADM-99' : 'SHG001-M' + (appState.members.findIndex(m => m.username === myUser.username) + 1)}</p>
                </div>
            </div>
            
            <!-- Member contribution card and history -->
            <div class="grid md:grid-cols-3 gap-6">
                <!-- Payment status box -->
                <div class="border rounded-xl p-5 flex flex-col justify-between ${paymentStatus ? 'border-emerald-200 bg-emerald-50/50' : 'border-amber-200 bg-amber-50/30'}">
                    <div>
                        <span class="text-xs text-slate-500 font-semibold uppercase">My Contribution Status (August 2026)</span>
                        <div class="flex items-center gap-2 mt-2">
                            <span class="text-3xl font-extrabold text-slate-800">₹1,000.00</span>
                            <span class="status-pill ${paymentStatus ? 'status-verified' : 'status-pending'}">
                                ${paymentStatus ? '✓ VERIFIED' : '⏰ PENDING'}
                            </span>
                        </div>
                        <p class="text-xs text-slate-500 mt-1.5">${paymentStatus ? 'Your payment is safely reconciled and deposited in the SHG Bank Account.' : 'Monthly contribution is due. Submit payment digitally to avoid group shortfall.'}</p>
                    </div>
                    
                    ${paymentStatus ? `
                        <div class="mt-4 flex flex-col gap-2">
                            <span class="bg-emerald-100 text-emerald-800 font-extrabold text-xs px-3 py-2 rounded-lg border border-emerald-300 text-center block">
                                ✓ CONTRIBUTION VERIFIED
                            </span>
                            <button onclick="showReceipt({
                                shgName: 'Mahila Jyothi SHG',
                                memberName: '${myUser.full_name}',
                                amount: 1000.00,
                                purpose: 'Monthly Contribution Dues',
                                date: '${myPayment.payment_date || "08 Aug 2026"}',
                                txnId: '${myPayment.txn_id || "SHG-DEMO-0001"}',
                                status: 'VERIFIED',
                                message: 'Payment successfully recorded in SHG financial ledger.'
                            });" class="w-full bg-slate-100 hover:bg-slate-200 text-slate-700 font-bold text-xs py-2.5 rounded-lg transition text-center uppercase tracking-wider">
                                📄 VIEW DIGITAL RECEIPT
                            </button>
                        </div>
                    ` : `
                        <button onclick="initiatePayment();" class="mt-4 bg-emerald-800 hover:bg-emerald-950 text-white font-extrabold text-xs py-3.5 px-4 rounded-lg transition shadow-sm w-full uppercase tracking-wider">
                            💳 PAY MONTHLY CONTRIBUTION
                        </button>
                    `}
                </div>
                
                <!-- Group stats status overview -->
                <div class="border border-slate-200 rounded-xl p-5 space-y-4 bg-white flex flex-col justify-between">
                    <div>
                        <span class="text-xs text-slate-400 font-semibold uppercase block mb-1">Group Contribution Rate</span>
                        <div class="flex justify-between items-baseline">
                            <span class="text-2xl font-extrabold text-slate-800">${appState.members.filter(m => m.status === 'VERIFIED').length}/10 Paid</span>
                            <span class="text-xs font-semibold text-slate-500">Expected: ₹10,000</span>
                        </div>
                        
                        <!-- Simple progress bar -->
                        <div class="w-full bg-slate-100 rounded-full h-2 mt-3">
                            <div class="bg-emerald-700 h-2 rounded-full transition-all duration-500" style="width: ${appState.members.filter(m => m.status === 'VERIFIED').length * 10}%"></div>
                        </div>
                    </div>
                    
                    <div class="flex justify-between text-xs font-semibold pt-2 border-t border-slate-100">
                        <span class="text-emerald-700 font-bold">Verified: ₹${(appState.members.filter(m => m.status === 'VERIFIED').length * 1000).toLocaleString('en-IN')}</span>
                        <span class="text-amber-700 font-bold">Pending: ₹${(appState.members.filter(m => m.status !== 'VERIFIED').length * 1000).toLocaleString('en-IN')}</span>
                    </div>
                </div>

                <!-- My Payment History box -->
                <div class="border border-slate-200 rounded-xl p-5 space-y-4 bg-white">
                    <span class="text-xs text-slate-400 font-bold uppercase block tracking-wider">My Payment History</span>
                    <div class="space-y-2">
                        ${historyHTML}
                    </div>
                </div>
            </div>
            
            <!-- Member verification alerts box -->
            ${verificationsHTML ? `
                <div class="space-y-4">
                    <h3 class="font-extrabold text-slate-800 text-sm tracking-wider uppercase">⚠️ Important Approvals & Voting</h3>
                    ${verificationsHTML}
                </div>
            ` : ''}
        </div>
    `;
}

// --- LEADER WORKFLOW VIEW ---
function renderLeaderDashboardHTML() {
    const listItems = appState.members.map(m => {
        const isPaid = m.status === 'VERIFIED';
        return `
            <tr class="hover:bg-slate-50/50 transition">
                <td class="px-4 py-3 text-xs font-bold text-slate-800">${m.full_name}</td>
                <td class="px-4 py-3 text-[10px] font-mono text-slate-500">${m.username === 'sujatha' ? 'SHG001-M03' : 'SHG001-M' + (appState.members.indexOf(m) + 1).toString().padStart(2, '0')}</td>
                <td class="px-4 py-3 text-xs font-semibold text-slate-700">₹${m.amount ? m.amount.toLocaleString('en-IN') : '1,000'}</td>
                <td class="px-4 py-3">
                    <span class="status-pill ${isPaid ? 'status-verified' : 'status-pending'}">
                        ${isPaid ? '✓ PAID' : '⏰ PENDING'}
                    </span>
                </td>
                <td class="px-4 py-3 text-xs text-slate-500">${m.payment_date || '-'}</td>
                <td class="px-4 py-3 font-mono text-[10px]">${m.txn_id ? `<span class="bg-slate-100 px-1 rounded">${m.txn_id}</span>` : '-'}</td>
            </tr>
        `;
    }).join('');

    return `
        <div class="glass-panel p-8 rounded-2xl border border-slate-200 space-y-6">
            <div class="flex flex-wrap justify-between items-center gap-4 border-b border-slate-100 pb-5">
                <div>
                    <h2 class="font-extrabold text-2xl text-emerald-950">Leader Management Panel</h2>
                    <p class="text-xs text-slate-500 mt-1">Sujatha Rao (Group Leader) | Mahila Jyothi SHG</p>
                </div>
                <div class="flex gap-2">
                    <button onclick="openExpenseModal();" class="bg-emerald-800 hover:bg-emerald-900 text-white font-bold text-xs py-2 px-3 rounded-lg transition flex items-center gap-1 shadow-sm">
                        ➕ Log Expense
                    </button>
                </div>
            </div>
            
            <!-- Member contribution table -->
            <div class="space-y-3">
                <h3 class="font-bold text-sm text-slate-800 tracking-wider uppercase">Member Contribution Board</h3>
                <div class="overflow-x-auto border border-slate-150 rounded-xl bg-white shadow-sm">
                    <table class="w-full text-left border-collapse">
                        <thead>
                            <tr class="bg-slate-50 text-[10px] font-extrabold text-slate-500 uppercase tracking-wider border-b border-slate-150">
                                <th class="px-4 py-2.5">Member Name</th>
                                <th class="px-4 py-2.5">ID Code</th>
                                <th class="px-4 py-2.5">Amount</th>
                                <th class="px-4 py-2.5">Status</th>
                                <th class="px-4 py-2.5">Date</th>
                                <th class="px-4 py-2.5">Transaction Ref</th>
                            </tr>
                        </thead>
                        <tbody class="divide-y divide-slate-100">
                            ${listItems}
                        </tbody>
                    </table>
                </div>
            </div>
            
            <!-- Audit Log header inside Leader View -->
            <div class="space-y-3">
                <h3 class="font-bold text-sm text-slate-800 tracking-wider uppercase">🔒 Group Audit Trail (Platform Logs)</h3>
                <div class="max-h-48 overflow-y-auto border border-slate-200 rounded-xl bg-slate-50 p-4 space-y-2">
                    ${appState.auditLogs.map(log => `
                        <div class="text-[11px] text-slate-600 flex flex-wrap justify-between gap-1 border-b border-slate-200/50 pb-1.5 last:border-0 last:pb-0">
                            <span>
                                <span class="text-slate-400 font-mono">${log.timestamp.split(' ')[1] || log.timestamp}</span> 
                                <strong class="text-slate-700">${log.username}</strong> 
                                <span class="bg-slate-200 px-1 py-0.5 rounded text-[8px] font-bold text-slate-500 uppercase">${log.role}</span>:
                                ${log.action} - ${log.details}
                            </span>
                        </div>
                    `).join('')}
                </div>
            </div>
        </div>
    `;
}

// --- AUTHORIZED REVIEWER WORKFLOW VIEW ---
function renderReviewerDashboardHTML() {
    const listDisputes = appState.disputes.map(d => {
        const isResolved = d.status === 'RESOLVED';
        return `
            <div class="border rounded-xl p-4 space-y-3 bg-white ${isResolved ? 'opacity-60' : 'border-purple-200'}">
                <div class="flex justify-between items-start">
                    <div>
                        <span class="bg-purple-100 text-purple-800 text-[9px] font-bold px-2 py-0.5 rounded-full uppercase">${d.transaction_type} DISPUTE</span>
                        <h4 class="font-extrabold text-sm text-slate-800 mt-1">Dispute: DISP-${d.id.toString().padStart(4, '0')}</h4>
                        <p class="text-[10px] text-slate-400 mt-0.5">Raised by: ${d.full_name} (${d.username}) | Date: ${d.created_at}</p>
                    </div>
                    <span class="status-pill ${isResolved ? 'status-verified' : 'status-review'}">
                        ${d.status}
                    </span>
                </div>
                <div class="bg-slate-50 p-3 rounded-lg border text-xs text-slate-600">
                    <strong>Reason Filed:</strong> "${d.reason}"
                </div>
                
                ${isResolved ? '' : `
                    <div class="flex gap-2 justify-end">
                        <button onclick="resolveDispute('DISP-${d.id.toString().padStart(4, '0')}', 'APPROVED');" class="bg-emerald-800 hover:bg-emerald-950 text-white font-bold text-[10px] px-3 py-1.5 rounded-md transition">
                            ✓ Approve Transaction
                        </button>
                        <button onclick="resolveDispute('DISP-${d.id.toString().padStart(4, '0')}', 'CANCELLED');" class="bg-red-600 hover:bg-red-700 text-white font-bold text-[10px] px-3 py-1.5 rounded-md transition">
                            ✗ Cancel Transaction
                        </button>
                    </div>
                `}
            </div>
        `;
    }).join('') || '<div class="text-center text-xs text-slate-400 py-6">No open disputes reported in monitoring registry.</div>';

    return `
        <div class="glass-panel p-8 rounded-2xl border border-slate-200 space-y-6">
            <div class="border-b border-slate-100 pb-5">
                <h2 class="font-extrabold text-2xl text-emerald-950">Authorized Review Registry</h2>
                <p class="text-xs text-slate-500 mt-1">FinTech Platform Audit Officer Panel (SBI & AP-State Gov Monitored)</p>
            </div>
            
            <!-- Aggregated Monitoring Stats (Simulated) -->
            <div class="grid grid-cols-2 sm:grid-cols-4 gap-4">
                <div class="bg-white border rounded-xl p-4 shadow-sm text-center">
                    <span class="text-xs text-slate-400 font-semibold uppercase block">SHGs Monitored</span>
                    <span class="text-2xl font-black text-slate-800 mt-1">125</span>
                </div>
                <div class="bg-white border rounded-xl p-4 shadow-sm text-center">
                    <span class="text-xs text-slate-400 font-semibold uppercase block">Active Shortfalls</span>
                    <span class="text-2xl font-black text-amber-600 mt-1">${appState.scenario === 'B' || appState.scenario === 'F' ? '13' : '12'}</span>
                </div>
                <div class="bg-white border rounded-xl p-4 shadow-sm text-center">
                    <span class="text-xs text-slate-400 font-semibold uppercase block">Open Disputes</span>
                    <span class="text-2xl font-black text-red-600 mt-1">${appState.disputes.filter(d => d.status === 'OPEN').length}</span>
                </div>
                <div class="bg-white border rounded-xl p-4 shadow-sm text-center">
                    <span class="text-xs text-slate-400 font-semibold uppercase block">Mismatches</span>
                    <span class="text-2xl font-black text-red-600 mt-1">${appState.reconciliation.mismatch ? '1' : '0'}</span>
                </div>
            </div>
            
            <!-- Dispute Registry List -->
            <div class="space-y-4">
                <h3 class="font-bold text-sm text-slate-800 tracking-wider uppercase">Active Disputes & Concerns Registry</h3>
                <div class="space-y-3 max-h-96 overflow-y-auto pr-1">
                    ${listDisputes}
                </div>
            </div>
        </div>
    `;
}

