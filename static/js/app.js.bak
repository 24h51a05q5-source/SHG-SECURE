            </div>
            
            <!-- Quick Role Switching dropdown for evaluator convenience -->
            <div class="flex items-center gap-2">
                <span class="text-xs text-slate-500 font-semibold hidden md:inline">Quick Role Switch:</span>
                <select id="header-role-switcher" onchange="handleLoginAction(this.value);" class="bg-white border border-slate-200 text-xs font-bold text-slate-700 py-1.5 px-3 rounded-lg focus:outline-none focus:border-emerald-800">
                    <option value="lakshmi" ${appState.currentUser.username === 'lakshmi' ? 'selected' : ''}>Lakshmi (Member)</option>
                    <option value="sujatha" ${appState.currentUser.username === 'sujatha' ? 'selected' : ''}>Sujatha (Leader)</option>
                    <option value="reviewer" ${appState.currentUser.username === 'reviewer' ? 'selected' : ''}>Bank Reviewer (Review Officer)</option>
                    <option value="admin" ${appState.currentUser.username === 'admin' ? 'selected' : ''}>System Admin</option>
                </select>
            </div>
            
            <div class="flex items-center gap-4">
                <div class="flex items-center gap-2">
                    <div class="text-right hidden sm:block">
                        <p class="text-xs font-bold text-slate-800">${appState.currentUser.full_name}</p>
                        <p class="text-[10px] text-slate-500 font-medium">ID: ${appState.currentUser.username === 'reviewer' ? 'RO-001' : appState.currentUser.username === 'admin' ? 'ADM-99' : 'SHG001-M' + (appState.members.findIndex(m => m.username === appState.currentUser.username) + 1)}</p>
                    </div>
                    <span class="border px-2 py-0.5 rounded-full text-[10px] font-extrabold tracking-wider ${roleColors[appState.currentUser.role] || 'bg-slate-100'}">${appState.currentUser.role}</span>
                </div>
                <button onclick="handleLogoutAction();" class="text-slate-500 hover:text-slate-800 transition text-sm font-semibold border border-slate-200 px-3 py-1.5 rounded-lg bg-white">
                    Sign Out
                </button>
            </div>
        </div>
    `;
}

