    members: [],
    loans: [],
    expenses: [],
    disputes: [],
    alerts: [],
    auditLogs: [],
    reconciliation: {},
    riskScore: {},
    currentLanguage: 'en',
    currentView: 'landing', // 'landing' or 'dashboard'
    isLoading: false,
    demoGuidedStep: 0,
    demoGuidedActive: false
};

